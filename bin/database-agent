#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def _project_root() -> Path:
    return Path(__file__).resolve().parents[1]

def _reexec_into_venv() -> None:
    """Prefer project venv interpreter if present, so users needn't activate it."""
    venv_python = _project_root() / ".venv" / "bin" / "python"
    try:
        if venv_python.exists() and venv_python.is_file():
            if Path(sys.executable).resolve() != venv_python.resolve():
                os.execv(str(venv_python), [str(venv_python), *sys.argv])
    except Exception:
        return


def _run_nl_mode(args: argparse.Namespace) -> int:
    from datasaa_runtime.agent import AgentConfig, AgentRuntime
    from datasaa_runtime.providers.openai_compat import OpenAICompatConfig, OpenAICompatProvider
    from datasaa_runtime.tools.registry import ToolRegistry

    workspace = os.getenv("DATASSA_WORKSPACE", str((_project_root() / "workspace").resolve()))
    api_base = os.getenv("LLM_API_BASE", "https://api.deepseek.com")
    api_key = os.getenv("LLM_API_KEY", "")
    model = os.getenv("LLM_MODEL", "deepseek-reasoner")
    if not api_key:
        print("missing env: LLM_API_KEY", file=sys.stderr)
        return 2

    provider = OpenAICompatProvider(OpenAICompatConfig(api_base=api_base, api_key=api_key, model=model))
    runtime = AgentRuntime(cfg=AgentConfig(workspace=workspace), provider=provider, tools=ToolRegistry())

    async def _one(msg: str) -> int:
        out = await runtime.process(session_key=args.session, user_message=msg)
        print(out["content"])
        return 0

    import anyio

    if args.message is not None:
        return anyio.run(_one, args.message)

    print("NL mode. Type 'exit' to quit.")
    while True:
        try:
            line = input("NL> ").strip()
        except (EOFError, KeyboardInterrupt):
            break
        if not line:
            continue
        if line.lower() in {"exit", "quit"}:
            break
        anyio.run(_one, line)
    return 0


def _run_api(args: argparse.Namespace) -> int:
    import uvicorn

    uvicorn.run(
        "server.main:app",
        host=args.host,
        port=args.port,
        reload=args.reload,
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    _reexec_into_venv()
    os.chdir(_project_root())
    sys.path.insert(0, str(_project_root()))

    p = argparse.ArgumentParser(prog="database-agent", description="DataSSA CLI (vendor-free)")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_agent = sub.add_parser("agent", help="Run agent in natural-language mode")
    p_agent.add_argument("-m", "--message", default=None, help="One-shot message (non-interactive)")
    p_agent.add_argument("-s", "--session", default="cli:direct")

    p_api = sub.add_parser("api", help="Run FastAPI server")
    p_api.add_argument("--host", default="0.0.0.0")
    p_api.add_argument("--port", type=int, default=18790)
    p_api.add_argument("--reload", action="store_true")

    args = p.parse_args(argv)

    if args.cmd == "api":
        return _run_api(args)
    if args.cmd == "agent":
        return _run_nl_mode(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
